# Rust build artifacts
/target/

# Fonte Rust empacotada para o build Flatpak (gerada por scripts/test-flatpak-package.sh)
/build-aux/flatpak/rust-src.tar

# CMake build artifacts dos recursos de teste
/test-resources/*/build/

# Temporary files
/tmp/

# Ephemeral WIP screenshots published to a Gist by `just screenshots-wip`
# (scripts/publish-wip-screenshots.sh) — never part of the project history.
/.wip-screenshots/

# Latest-run snapshots from diagnostic tests (e.g.
# verovio_6_2_0_transpile_diagnosis.rs), overwritten every run — local
# artifact, never part of the project history.
/.diagnosis/

# Editor and OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Environment files
.env
.env.*
!.env.example
